# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# npm cache redirected into workspace (sandbox workaround)
/.npm-cache
/.appdata

# playwright
/test-results
/playwright-report

# upstream reference clones (AGPL source kept out of this repo)
.scratch/photo-to-pattern/upstream/
.scratch/photo-to-pattern/research/perler-beads-master/
.scratch/photo-to-pattern/research/perler-beads-ai-main/
.scratch/photo-to-pattern/research/*.tar.gz
