# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-server*.log

# logs（本地运行残留：e2e-webkit.log、.scratch/e2e-run.log 等）
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# npm cache redirected into workspace (sandbox workaround)
/.npm-cache
/.appdata

# dev 本地持久化数据库（PGlite 回退库落盘目录）
/.pglite-dev/

# playwright
/test-results
/playwright-report
/tests/e2e/.tmp

# upstream reference clones (AGPL source kept out of this repo)
.scratch/photo-to-pattern/upstream/
.scratch/photo-to-pattern/research/perler-beads-master/
.scratch/photo-to-pattern/research/perler-beads-ai-main/
.scratch/photo-to-pattern/research/*.tar.gz

# 部署向导临时产物（prod.env 含生产数据库密码，严禁入库）
.scratch/deploy-wizard/

# 代理会话的临时脚本与产物（正式 spec/issue 走 .scratch/<feature>/ 子目录入库）
.scratch/*.py
.scratch/*.mjs
.scratch/*.json
.scratch/*.png
.scratch/*.err
.scratch/*.sh

# IDE
/.idea/


# 构建期生成的 PDF 子集字体（由 npm run prebuild 产出，见 scripts/build-pdf-font-subset.mjs）
/public/fonts/*.subset.otf
# 界面字体：源字体与子集产物都不入库（源字体体积大且各自有授权条款，
# 见 scripts/build-ui-font-subset.mjs 与 NOTICE.md）
/public/fonts/*.subset.ttf
/assets/fonts/
