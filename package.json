{
    "name": "doupu",
    "version": "0.3.1",
    "private": true,
    "author": "wuqian (https://github.com/527520)",
    "repository": {
        "type": "git",
        "url": "https://github.com/527520/doupu.git"
    },
    "bugs": {
        "url": "https://github.com/527520/doupu/issues"
    },
    "scripts": {
        "dev": "next dev",
        "prebuild": "npm run build:protocol-preflight && node scripts/build-pdf-font-subset.mjs && node scripts/build-ui-font-subset.mjs",
        "build:protocol-preflight": "node scripts/build-protocol-preflight.mjs",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --no-file-parallelism --maxWorkers=1 --project unit --project serial --project integration",
        "test:unit": "vitest run --project unit --project serial",
        "test:integration": "vitest run --project integration",
        "test:postgres-contract": "node tests/postgres/revision-contract.cjs",
        "test:protocol-preflight": "node tests/postgres/protocol-preflight-contract.cjs",
        "test:coverage": "vitest run --no-file-parallelism --maxWorkers=1 --coverage --project unit --project serial --project integration",
        "test:coverage:stable": "node tests/ci/repeat.cjs 5 npm run test:coverage",
        "test:performance": "vitest run --project performance",
        "test:performance:stable": "node tests/ci/repeat.cjs 5 npm run test:performance",
        "test:e2e:check": "node tests/e2e/checkBrowsers.cjs",
        "test:e2e": "npm run test:e2e:check && playwright test",
        "test:e2e:production": "playwright test --config playwright.production.config.mts",
        "test:e2e:stable": "node tests/ci/repeat.cjs 3 npm run test:e2e",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node db/migrate.cjs"
    },
    "dependencies": {
        "@pdf-lib/fontkit": "^1.1.1",
        "argon2": "^0.45.1",
        "client-zip": "2.5.0",
        "drizzle-orm": "^0.45.2",
        "heic2any": "^0.0.4",
        "next": "16.3.1",
        "nodemailer": "^9.0.5",
        "pdf-lib": "^1.17.1",
        "pg": "^8.23.0",
        "qr": "0.6.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "subset-font": "^2.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@electric-sql/pglite": "^0.5.5",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/node": "^20",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.21.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "axe-core": "^4.13.0",
        "drizzle-kit": "^0.31.10",
        "esbuild": "0.28.2",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.3.1",
        "jsdom": "^30.0.1",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.10"
    }
}
