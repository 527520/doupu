# 豆谱反向代理与 TLS（Caddy 自动签发 Let's Encrypt 证书）
{$SITE_DOMAIN} {
	encode gzip

	# 注入真实客户端 IP：应用限流键（发信成本防护）只信任该头；
	# 客户端伪造的 X-Forwarded-For 因此失效（app 侧优先读取 x-real-ip）。
	request_header X-Real-IP {remote_host}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 注：Next.js 的 RSC 载荷需要内联脚本；script-src 'unsafe-inline' 是权衡后的妥协，
		# 全仓库无 dangerouslySetInnerHTML，XSS 面由 React 转义兜底。
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; script-src 'self' 'unsafe-inline'"
		-Server
	}

	reverse_proxy app:3000
}
