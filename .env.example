# 豆谱环境变量（复制为 .env 后填写；.env 不入库）

# ---- 站点 ----
SITE_DOMAIN=example.com
APP_URL=https://example.com

# ---- 数据库 ----
POSTGRES_DB=doupu
POSTGRES_USER=doupu
# 必填：强随机密码（如 openssl rand -hex 24）
POSTGRES_PASSWORD=
# 容器内互通使用 postgres 主机名；本机开发可用 localhost
DATABASE_URL=postgres://doupu:CHANGE_ME@postgres:5432/doupu

# ---- 邮件（腾讯云 SES API 模板发送：个人实名用户仅可用模板模式） ----
# SES_SECRET_ID=
# SES_SECRET_KEY=
# SES_REGION=ap-guangzhou
# SES_FROM=noreply@example.com
# SES 控制台创建的验证/重置模板 ID（模板内变量用 {{link}}）
# SES_VERIFY_TEMPLATE_ID=
# SES_RESET_TEMPLATE_ID=
# 全局每日发信上限（兜底；建议同时到 SES 控制台设置平台侧日发送上限）
# MAIL_DAILY_SEND_LIMIT=300
# 若改用企业邮箱等其他 SMTP 服务（任选其一）：
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# ---- 备份（腾讯云 COS，私有桶 + 30 天生命周期） ----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=doupu-backup-1250000000
COS_REGION=ap-guangzhou
